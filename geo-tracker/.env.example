# העתיקו לקובץ .env ומלאו רק את המפתחות שיש לכם. מנוע בלי מפתח פשוט לא ירוץ.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

XAI_API_KEY=
XAI_MODEL=grok-4

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# כמה פעמים לשאול כל מנוע כל פרומפט (התשובות משתנות בין הרצות)
REPETITIONS=3
# כמה בקשות במקביל לכל מנוע
CONCURRENCY=2

# שרת: ברירת מחדל רק מהמחשב המקומי. לפריסה בשרת הגדירו HOST=0.0.0.0 וגם ACCESS_TOKEN
PORT=8787
HOST=127.0.0.1
ACCESS_TOKEN=

# הרצה אוטומטית כל X שעות (0 = כבוי). למשל 168 = פעם בשבוע
SCHEDULE_HOURS=0

# MOCK=1 מריץ מנועים מדומים בלי מפתחות, לבדיקה
MOCK=0
