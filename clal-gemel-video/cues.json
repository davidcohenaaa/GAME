 ],
 "cues": [
  {
   "sec": 1,
   "i": 0,
   "text": "מהי קופת גמל להשקעה?",
   "start": 0.5,
   "end": 2.241
  },
  {
   "sec": 1,
   "i": 1,
   "text": "זהו מכשיר חיסכון גמיש, שמאפשר לכם לחסוך ולהשקיע כסף למגוון מטרות,",
   "start": 2.682,
   "end": 7.941
  },
  {
   "sec": 1,
   "i": 2,
   "text": "בטווח הקצר או הארוך.",
   "start": 8.289,
   "end": 9.932
  },
  {
   "sec": 1,
   "i": 3,
   "text": "אפשר להפקיד כסף באופן חד־פעמי או בהפקדות קבועות,",
   "start": 10.529,
   "end": 14.32
  },
  {
   "sec": 1,
   "i": 4,
   "text": "ולבחור מבין מגוון מסלולי השקעה.",
   "start": 14.693,
   "end": 16.881
  },
  {
   "sec": 1,
   "i": 5,
   "text": "והיתרון המשמעותי?",
   "start": 17.305,
   "end": 18.524
  },
  {
   "sec": 1,
   "i": 6,
   "text": "הכסף נשאר נזיל וניתן למשיכה בכל עת,",
   "start": 18.959,
   "end": 22.176
  },
  {
   "sec": 1,
   "i": 7,
   "text": "בכפוף לתשלום מס על הרווחים.",
   "start": 22.524,
   "end": 24.757
  },
  {
   "sec": 2,
   "i": 0,
   "text": "למרות השמות הדומים,",
   "start": 25.361,
   "end": 26.773
  },
  {
   "sec": 2,
   "i": 1,
   "text": "יש ביניהן הבדל חשוב.",
   "start": 27.029,
   "end": 28.552
  },
  {
   "sec": 2,
   "i": 2,
   "text": "קופת גמל רגילה מיועדת בעיקר לחיסכון פנסיוני,",
   "start": 29.272,
   "end": 32.78
  },
  {
   "sec": 2,
   "i": 3,
   "text": "והמשיכה ממנה כפופה לתנאים ולהגבלות.",
   "start": 33.262,
   "end": 36.118
  },
  {
   "sec": 2,
   "i": 4,
   "text": "לעומתה,",
   "start": 36.701,
   "end": 37.293
  },
  {
   "sec": 2,
   "i": 5,
   "text": "קופת גמל להשקעה מאפשרת למשוך את הכסף בכל עת.",
   "start": 37.723,
   "end": 41.426
  },
  {
   "sec": 2,
   "i": 6,
   "text": "בנוסף,",
   "start": 42.031,
   "end": 42.633
  },
  {
   "sec": 2,
   "i": 7,
   "text": "העברת החיסכון לקופה משלמת לקצבה",
   "start": 43.048,
   "end": 45.609
  },
  {
   "sec": 2,
   "i": 8,
   "text": "וקבלתו כקצבה חודשית לאחר גיל שישים",
   "start": 46.003,
   "end": 48.712
  },
  {
   "sec": 2,
   "i": 9,
   "text": "עשויות להעניק פטור ממס, בהתאם לתנאי החוק.",
   "start": 49.065,
   "end": 52.678
  },
  {
   "sec": 3,
   "i": 0,
   "text": "אז איך בוחרים קופת גמל להשקעה שמתאימה לכם?",
   "start": 53.291,
   "end": 56.52
  },
  {
   "sec": 3,
   "i": 1,
   "text": "קודם כול, מגדירים את מטרת החיסכון ואת משך הזמן שבו תרצו להשקיע.",
   "start": 57.142,
   "end": 61.982
  },
  {
   "sec": 3,
   "i": 2,
   "text": "לאחר מכן, בוחנים את מסלולי ההשקעה,",
   "start": 62.626,
   "end": 65.293
  },
  {
   "sec": 3,
   "i": 3,
   "text": "רמות הסיכון,",
   "start": 65.55,
   "end": 66.515
  },
  {
   "sec": 3,
   "i": 4,
   "text": "דמי הניהול ותשואות העבר,",
   "start": 66.808,
   "end": 68.856
  },
  {
   "sec": 3,
   "i": 5,
   "text": "שחשוב לזכור שאינן מבטיחות תשואה עתידית.",
   "start": 69.219,
   "end": 72.221
  },
  {
   "sec": 3,
   "i": 6,
   "text": "וכדאי לדעת,",
   "start": 72.852,
   "end": 73.696
  },
  {
   "sec": 3,
   "i": 7,
   "text": "ניתן לעבור בין מסלולי השקעה מבלי שהמעבר ייחשב לאירוע מס.",
   "start": 73.998,
   "end": 78.617
  },
  {
   "sec": 4,
   "i": 0,
   "text": "עם מגוון מסלולי ההשקעה של כלל גמל לעתיד,",
   "start": 79.21,
   "end": 82.206
  },
  {
   "sec": 4,
   "i": 1,
   "text": "תוכלו לבחור את מסלול החיסכון המתאים לצרכים שלכם.",
   "start": 82.607,
   "end": 85.844
  },
  {
   "sec": 4,
   "i": 2,
   "text": "כלל ביטוח ופיננסים.",
   "start": 86.312,
   "end": 88.017
  }
 ]
}